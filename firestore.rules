rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles. A user may create their own doc on first sign-in but
    // can never grant themselves status/role -- only an admin can.
    //
    // They CAN write their own `name` and `jobRole` -- what they do, which is
    // how an admin recognises who is asking. `jobRole` is deliberately not
    // `role`: the update rule below freezes `role` and `status` at whatever
    // the document already says, so nothing a user types about themselves
    // can change what they are allowed to see.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'user';
      allow update: if isAdmin() ||
        (isSelf(userId) &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.role == resource.data.role &&
          // Nor may they grant themselves the right to message everybody.
          // Frozen the same way `role` is, and for the same reason: the
          // fields that say what somebody may DO are an admin's to write.
          // `get()` on a missing key returns null on both sides, so an
          // account predating these fields compares equal and can still
          // save its own name.
          request.resource.data.get('canSendMessages', true) ==
            resource.data.get('canSendMessages', true) &&
          request.resource.data.get('canReceiveMessages', true) ==
            resource.data.get('canReceiveMessages', true));
      allow delete: if isAdmin();
    }

    // Per-user, per-page grants: access/{uid}_{pageId}
    //
    // NOTE: `get` only. Rules are filters for nobody -- a LIST query over
    // this collection would be rejected outright for a non-admin, because it
    // could return another user's grant. The client therefore reads these
    // one document at a time by exact id (see hooks/useWorkspace.js); do not
    // "optimise" that into a collection query.
    match /access/{accessId} {
      allow get: if isAdmin() || (isSignedIn() && accessId.matches(request.auth.uid + '_.*'));
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Workspace-wide settings. Today that's `settings/entrance` -- the brand
    // wordmark and the campaign / achievement cards on the splash screen.
    //
    // Readable by ANYONE, signed in or not, which is the one deliberate
    // exception in this file. The entrance plays while authentication is
    // still resolving, so gating it on sign-in would mean it silently never
    // showed its content. Nothing here is sensitive -- it is a greeting
    // screen, and every word of it was written to be shown to people.
    // Writing is still admins only.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Personal, per-user, per-page settings: userPrefs/{uid}_{pageId}
    //
    // The ONE collection an ordinary user may write to, and deliberately the
    // most boring one -- widget display order and their own sticky notes.
    // It grants no access and hides no widget, so the worst a user can do
    // by writing here is rearrange their own screen and leave themselves a
    // reminder on it. The id prefix check is what keeps them out of anyone
    // else's, and is why a note is readable only by the person who wrote
    // it.
    //
    // `get` only, for the same reason as `access` above: a list query would
    // be rejected wholesale rather than narrowed.
    match /userPrefs/{prefId} {
      allow get: if isSignedIn() && prefId.matches(request.auth.uid + '_.*');
      allow list: if isAdmin();
      allow write: if isSignedIn() && prefId.matches(request.auth.uid + '_.*');
    }

    // Messages between people using the dashboard.
    //
    // The second collection an ordinary user may write to, and the first one
    // where what they write is seen by somebody else -- so the rules here do
    // more work than anywhere else in this file.
    //
    // Three things are enforced:
    //
    //   YOU CAN ONLY READ WHAT WAS SENT TO YOU. `list` is evaluated per
    //   document, so a query that could return somebody else's message is
    //   rejected outright rather than quietly narrowed. The client therefore
    //   asks two constrained questions -- "addressed to me" and "addressed to
    //   everyone" -- and merges them (see hooks/useMessages.js). Do not
    //   "optimise" that into one unfiltered query; it will fail for everyone
    //   who is not an admin.
    //
    //   YOU CANNOT SEND AS SOMEBODY ELSE. `from` must be your own uid, which
    //   is what stops a message appearing to come from the boss.
    //
    //   A RECIPIENT MAY ONLY MARK AND REPLY. The update rule freezes every
    //   field except the three that are a recipient's own state, and checks
    //   that the two id lists grew by AT MOST the writer's own uid -- so
    //   nobody can dismiss a message on another person's behalf, or edit the
    //   body of something already delivered.
    match /messages/{messageId} {
      function forMe() {
        return isSignedIn() && (
          resource.data.from == request.auth.uid ||
          resource.data.audience == 'all' ||
          request.auth.uid in resource.data.to
        );
      }
      // Only the writer's own id may appear that was not there before.
      function onlyAddsSelf(field) {
        return request.resource.data[field].hasOnly(
          resource.data[field].concat([request.auth.uid])
        ) && resource.data[field].hasOnly(request.resource.data[field]);
      }

      allow get, list: if isAdmin() || forMe();

      // One extra read per message SENT -- not per message read -- to ask
      // whether this person is allowed to send at all. Absent means yes, so
      // turning the field on for one account does not switch everybody else
      // off. Enforced here rather than only in the composer, because a rule
      // that lives in a form is a rule anybody with a console can skip.
      function maySend() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('canSendMessages', true) == true;
      }

      allow create: if isSignedIn() && maySend() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 600 &&
        request.resource.data.audience in ['all', 'people'] &&
        request.resource.data.readBy.size() == 0 &&
        request.resource.data.dismissedBy.size() == 0 &&
        request.resource.data.replies.size() == 0;

      // A reply may only be APPENDED, and only as yourself.
      //
      // Checking that the list did not shrink is not enough and was the
      // hole this closes: a two-reply list replaced by two different
      // replies passes a size check while rewriting what somebody else
      // said, on a thread other people have already read. So the actual
      // elements are compared -- nothing may leave, at most one may
      // arrive, and the one that arrives must be signed with the writer's
      // own uid.
      function repliesAdded() {
        return request.resource.data.get('replies', [])
          .removeAll(resource.data.get('replies', []));
      }
      function repliesGone() {
        return resource.data.get('replies', [])
          .removeAll(request.resource.data.get('replies', []));
      }

      allow update: if forMe() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readBy', 'dismissedBy', 'replies']) &&
        onlyAddsSelf('readBy') &&
        onlyAddsSelf('dismissedBy') &&
        repliesGone().size() == 0 &&
        repliesAdded().size() <= 1 &&
        (repliesAdded().size() == 0 || repliesAdded()[0].from == request.auth.uid);

      // Unsending is the sender's business, and an admin's.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.from == request.auth.uid);
    }

    // Connected spreadsheets: which sheet, and which of its tabs this
    // workspace may read.
    //
    // Readable by any signed-in user because the dashboard needs tab names
    // and headers to render, and neither is sensitive -- the SHEET DATA
    // itself never flows through here. It is read server-side by the service
    // account in api/sheets.js, which re-checks the caller's page access
    // before returning a single row. `tabHeaders` is written by that same
    // route through the Admin SDK, which bypasses these rules entirely.
    // Remarks on a row.
    //
    // A shared sticky note: several people write on the same document, each
    // remark carrying the name of whoever wrote it. Two things are enforced,
    // and both are about the LIST, because it is the only field anybody
    // writes to.
    //
    //   YOU WRITE AS YOURSELF. Every remark that arrives must carry the
    //   writer's own uid. Without this one person could add a remark signed
    //   by another -- which, on a note colleagues make decisions from, is the
    //   whole game.
    //
    //   YOU CHANGE ONLY YOUR OWN, AND ONLY THE WORDS. An update may add one
    //   remark, take away one of your own, or reword one of your own -- and
    //   nothing else moves. A reworded remark must keep its author and the
    //   moment it was first written, or "edit" becomes a way to put words in
    //   somebody else's mouth or to make a remark look older than the thing
    //   it is about. It must also arrive carrying `editedAt`: a remark
    //   colleagues have already acted on quietly becoming a different
    //   sentence is the hazard; one that says it was changed is a
    //   correction.
    //
    // Both are checked by set DIFFERENCE rather than by counting: `hasAll`
    // alone would prove a list did not shrink while saying nothing about
    // WHOSE remark had gone. `added` and `gone` are the actual elements that
    // changed, so the rule can look at their `by` field.
    //
    // Reading is open to anybody signed in. Row scoping is applied in the
    // browser -- the whole tab already reaches it, see Dashboard.jsx -- so
    // narrowing here would protect nothing that is not already on the page.
    match /rowNotes/{noteId} {
      function remarksIn(data) {
        return data.get('remarks', []);
      }
      function added() {
        return remarksIn(request.resource.data).removeAll(remarksIn(resource.data));
      }
      function gone() {
        return remarksIn(resource.data).removeAll(remarksIn(request.resource.data));
      }

      allow get, list: if isSignedIn();

      // The first remark creates the note, so a create IS one remark.
      allow create: if isSignedIn() &&
        request.resource.data.scope is string &&
        request.resource.data.key is string &&
        remarksIn(request.resource.data).size() == 1 &&
        remarksIn(request.resource.data)[0].by == request.auth.uid;

      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['scope', 'key', 'remarks']) &&
        request.resource.data.get('scope', '') == resource.data.get('scope', '') &&
        request.resource.data.get('key', '') == resource.data.get('key', '') &&
        (
          // Added one of my own, and took nothing away.
          (added().size() == 1 && added()[0].by == request.auth.uid && gone().size() == 0) ||
          // Or took away one of my own, and added nothing.
          (gone().size() == 1 && gone()[0].by == request.auth.uid && added().size() == 0) ||
          // Or reworded one of my own: one out, one in, and the one that
          // came in is the SAME REMARK -- same author, same name against it,
          // same moment it was first written -- now stamped as edited.
          (
            added().size() == 1 && gone().size() == 1 &&
            gone()[0].by == request.auth.uid &&
            added()[0].by == gone()[0].by &&
            added()[0].byName == gone()[0].byName &&
            added()[0].at == gone()[0].at &&
            'editedAt' in added()[0]
          )
        );

      // Sweeping up a whole note is an admin's job. One person deleting the
      // record of what eleven people said is not a thing to leave lying about.
      allow delete: if isAdmin();
    }

    // One whole dashboard: its own pages, its own sheet connections, its
    // own entrance. See lib/spaces.js. Only the NAME of a dashboard lives
    // here -- what is in it is decided by the `space` field on the pages and
    // sources themselves, so listing this grants nothing beyond the names.
    //
    // Readable by any signed-in user because the sidebar has to know what a
    // dashboard is called before it can offer it; which ones a person may
    // actually open is still decided by their page grants, exactly as
    // before. There is deliberately no separate grant for a dashboard: two
    // permission models for one question is how they come to disagree.
    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /dataSources/{sourceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // A dashboard page: its widgets, filters, buttons and the sources it may
    // draw on. Readable by any signed-in user so the sidebar can be built;
    // whether they may see a page's DATA is decided by `access` above and
    // enforced server-side.
    match /dashboards/{pageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- v2 collections, kept readable so an unmigrated workspace still
    // --- works. Safe to delete once you've run the importer in the admin
    // --- panel and confirmed your pages look right.
    match /sheetConfigs/{page} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /layouts/{page} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
