# ── Client-side (Vite) — safe to expose in the browser bundle ───────────────
# Copy this file to .env for local dev. In Vercel, add each of these as a
# Project → Settings → Environment Variable of the same name instead.

# Firebase project settings (Project settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Branding shown on the sign-in screen and the entrance animation.
# Optional — defaults to "Chavan Udyog Samuh". These are only the FALLBACK:
# once an admin sets a brand name under Admin -> Entrance, that wins, so
# branding can be changed without a redeploy.
VITE_BRAND_NAME=Chavan Udyog Samuh
VITE_BRAND_TAGLINE=Business Intelligence Dashboard

# LEGACY — only read by the "Import previous setup" button in the admin panel,
# so it knows what the old two pages were called. Dashboard pages are created
# in the admin panel now and are not configured here. Safe to delete once
# you've migrated (or if you never ran the two-page version).
VITE_PAGE_A_LABEL=PREMIA
VITE_PAGE_B_LABEL=HERO

# ── Server-side (used only by /api/*.js serverless functions) ──────────────
# NEVER prefix these with VITE_ — that would bundle them into the browser JS.
# Set these in Vercel → Project → Settings → Environment Variables.

# Google Cloud service account that has been given access to your Sheets.
# The spreadsheet must be SHARED with this email, like sharing with a person.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Full Firebase Admin service account JSON, minified to one line
# (Firebase console → Project settings → Service accounts → Generate new
# private key). Used server-side to verify who's signed in.
FIREBASE_SERVICE_ACCOUNT_KEY=
